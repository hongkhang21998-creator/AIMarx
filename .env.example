# Cấu hình riêng từng máy: chép thành .env (không commit) và sửa theo máy.
# scripts/run-local.sh và run-local.ps1 chỉ nhận dòng TLVB_*=giá_trị; không có
# ngoặc kép, không chạy như mã. Biến đặt ở dòng lệnh thắng giá trị trong file.
#
# Máy ASUS: kho bắt buộc trên ổ Data1000 (chỉ đạo 11/09/2026).
# TLVB_DATA=/run/media/asus/Data1000/AIMarx/workspace/data
# TLVB_REQUIRED_MOUNT=/run/media/asus/Data1000
#
# TLVB_MODE=ollama
# TLVB_MODEL=qwen3:0.6b
# TLVB_PORT=8765
